{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/helpdeskpro-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=HelpDeskProDb;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Issuer": "HelpDeskPro",
    "Audience": "HelpDeskProClients",
    "SecretKey": "ThisIsASecretKeyForHelpDeskProSecuritySuperSecret2026!",
    "ExpiryHours": 8
  },
  "SeedSettings": {
    "DefaultPassword": "Dev@Passw0rd123!"
  },
  "AllowedHosts": "*"
}
