namespace HelpDeskPro.Web.Components.Admin;

@inject ISnackbar Snackbar
@inject IApiClient ApiClient

<MudDialog>
    <DialogContent>
        <div class="dialog-form-body">
            <MudText Typo="Typo.h6" Class="dialog-title mb-2">Reset password pengguna</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mb-4">
                Masukkan password baru untuk <strong>@User.FullName</strong> (@User.Email).
            </MudText>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                    @_errorMessage
                </MudAlert>
            }

            <MudTextField T="string" 
                          Label="Password baru" 
                          @bind-Value="_newPassword" 
                          InputType="InputType.Password"
                          Required="true" 
                          RequiredError="Password baru wajib diisi."
                          MaxLength="100" 
                          Immediate="true"
                          HelperText="Minimal 8 karakter"
                          Class="mb-2" 
                          Disabled="@_isSaving" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel" Disabled="@_isSaving" Size="Size.Small">
            Batal
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Submit" Disabled="@_isSaving" Size="Size.Small">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Memproses...</span>
            }
            else
            {
                <span>Reset password</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserListItemDto User { get; set; } = default!;

    private string _newPassword = string.Empty;
    private bool _isSaving = false;
    private string? _errorMessage;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 8)
        {
            _errorMessage = "Password baru minimal 8 karakter.";
            return;
        }

        _isSaving = true;

        try
        {
            var res = await ApiClient.ResetUserPasswordAsync(User.Id, _newPassword);
            if (res?.Success == true)
            {
                Snackbar.Add($"Password {User.FullName} berhasil direset.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = res?.Errors is { Count: > 0 } ? string.Join("; ", res.Errors) : "Gagal mereset password.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
