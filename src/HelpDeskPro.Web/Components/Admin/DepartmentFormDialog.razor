namespace HelpDeskPro.Web.Components.Admin;

@inject ISnackbar Snackbar
@inject IApiClient ApiClient

<MudDialog>
    <DialogContent>
        <div class="dialog-form-body">
            <MudText Typo="Typo.h6" Class="dialog-title mb-4">
                @(Department == null ? "Tambah departemen" : "Ubah departemen")
            </MudText>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                    @_errorMessage
                </MudAlert>
            }

            <MudTextField T="string" 
                          Label="Kode departemen" 
                          @bind-Value="_code" 
                          Required="true" 
                          RequiredError="Kode wajib diisi."
                          MaxLength="10" 
                          Immediate="true"
                          HelperText="Contoh: IT, HR, FIN (2–10 karakter)"
                          Class="mb-3" 
                          Disabled="@_isSaving" />

            <MudTextField T="string" 
                          Label="Nama departemen" 
                          @bind-Value="_name" 
                          Required="true" 
                          RequiredError="Nama departemen wajib diisi."
                          MaxLength="100" 
                          Immediate="true"
                          HelperText="Contoh: Teknologi Informasi (2–100 karakter)"
                          Class="mb-2" 
                          Disabled="@_isSaving" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel" Disabled="@_isSaving" Size="Size.Small">
            Batal
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@_isSaving" Size="Size.Small">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public DepartmentDto? Department { get; set; }

    private string _code = string.Empty;
    private string _name = string.Empty;
    private bool _isSaving = false;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (Department != null)
        {
            _code = Department.Code;
            _name = Department.Name;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_code) || _code.Trim().Length < 2)
        {
            _errorMessage = "Kode departemen minimal 2 karakter.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_name) || _name.Trim().Length < 2)
        {
            _errorMessage = "Nama departemen minimal 2 karakter.";
            return;
        }

        _isSaving = true;

        try
        {
            if (Department == null)
            {
                var command = new CreateDepartmentCommand(_code.Trim().ToUpperInvariant(), _name.Trim());
                var res = await ApiClient.CreateDepartmentAsync(command);
                if (res?.Success == true)
                {
                    Snackbar.Add("Departemen berhasil ditambahkan.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(res.Data));
                }
                else
                {
                    _errorMessage = res?.Errors is { Count: > 0 } ? string.Join("; ", res.Errors) : "Gagal menambahkan departemen.";
                }
            }
            else
            {
                var command = new UpdateDepartmentCommand(Department.Id, _code.Trim().ToUpperInvariant(), _name.Trim(), Department.IsActive);
                var res = await ApiClient.UpdateDepartmentAsync(Department.Id, command);
                if (res?.Success == true)
                {
                    Snackbar.Add("Departemen berhasil diperbarui.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(res.Data));
                }
                else
                {
                    _errorMessage = res?.Errors is { Count: > 0 } ? string.Join("; ", res.Errors) : "Gagal memperbarui departemen.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
