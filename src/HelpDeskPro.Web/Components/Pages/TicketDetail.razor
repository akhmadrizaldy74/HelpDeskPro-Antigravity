    private async Task HandleAddCommentAsync()
    {
        if (_ticket == null || string.IsNullOrWhiteSpace(_newCommentBody)) return;
        _isSubmittingComment = true;

        try
        {
            var res = await ApiClient.AddCommentAsync(_ticket.Id, _newCommentBody.Trim(), _isCommentInternal);
            if (res?.Success == true)
            {
                _newCommentBody = string.Empty;
                _isCommentInternal = false;
                Snackbar.Add("Komentar berhasil ditambahkan.", Severity.Success);
                await LoadTicketDetailsAsync();
            }
            else
            {
                CheckForConflict(res?.Errors.FirstOrDefault());
            }
        }
        catch (Exception ex)
        {
            CheckForConflict(ex.Message);
        }
        finally
        {
            _isSubmittingComment = false;
        }
    }

    private async Task HandleUploadAttachmentAsync(InputFileChangeEventArgs e)
    {
        if (_ticket == null) return;

        var file = e.File;
        if (file == null) return;

        // Client-side validation: max 5 MB
        if (file.Size > 5 * 1024 * 1024)
        {
            Snackbar.Add("Ukuran file melebihi batas maksimal 5 MB.", Severity.Error);
            return;
        }

        // Allowed extensions
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        string[] allowed = [".jpg", ".jpeg", ".png", ".pdf", ".docx", ".xlsx", ".txt", ".log"];
        if (!allowed.Contains(ext))
        {
            Snackbar.Add($"Tipe file {ext} tidak diizinkan.", Severity.Error);
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var res = await ApiClient.UploadAttachmentAsync(_ticket.Id, stream, file.Name, file.ContentType, file.Size);
            if (res?.Success == true)
            {
                Snackbar.Add($"File {file.Name} berhasil diunggah.", Severity.Success);
                await LoadTicketDetailsAsync();
            }
            else
            {
                Snackbar.Add(res?.Errors.FirstOrDefault() ?? "Gagal mengunggah file.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal mengunggah file: {ex.Message}", Severity.Error);
        }
    }

    private void CheckForConflict(string? error)
    {
        if (error != null && (error.Contains("diubah pengguna lain") || error.Contains("Conflict") || error.Contains("409")))
        {
            _hasConflict = true;
        }
        else
        {
            Snackbar.Add(error ?? "Terjadi kesalahan.", Severity.Error);
        }
    }

    private async Task CopyTicketNo()
    {
        if (_ticket == null) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _ticket.TicketNo);
            Snackbar.Add("Disalin", Severity.Normal, config =>
            {
                config.ShowCloseIcon = false;
                config.VisibleStateDuration = 1500;
            });
        }
        catch { }
    }

    private async Task DownloadAttachmentAsync(TicketAttachmentDto attachment)
    {
        try
        {
            var res = await ApiClient.DownloadAttachmentAsync(Id, attachment.Id);
            if (res?.Success != true || res.Data == null)
            {
                Snackbar.Add(res?.Errors.FirstOrDefault() ?? "Gagal mengunduh file.", Severity.Error);
                return;
            }

            using var memory = new MemoryStream(res.Data.Content);
            using var streamRef = new DotNetStreamReference(memory);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", attachment.FileName, res.Data.ContentType, streamRef);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Tidak dapat terhubung ke server API.", Severity.Error);
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string GetFileIcon(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".jpg" or ".jpeg" or ".png" => Icons.Material.Filled.Image,
            ".docx" => Icons.Material.Filled.Description,
            ".xlsx" => Icons.Material.Filled.TableChart,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    private static string GetFieldLabel(string? fieldName) => fieldName switch
    {
        "Status" => "Status",
        "Assignee" => "Penanggung jawab",
        "Priority" => "Prioritas",
        "Category" => "Kategori",
        "Title" => "Judul",
        "Description" => "Deskripsi",
        "Rating" => "Rating",
        _ => fieldName ?? "Data"
    };

    private static string FormatHistoryValue(string? fieldName, string? value)
    {
        if (fieldName == "Status" && Enum.TryParse<TicketStatus>(value, out var status))
        {
            return GetStatusText(status);
        }

        return value ?? string.Empty;
    }

    private static string GetStatusText(TicketStatus status) => status switch
    {
        TicketStatus.Open => "Open",
        TicketStatus.InProgress => "In Progress",
        TicketStatus.Pending => "Pending",
        TicketStatus.Resolved => "Resolved",
        TicketStatus.Closed => "Closed",
        TicketStatus.Cancelled => "Cancelled",
        _ => status.ToString()
    };

    private static string GetUserInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        }
        return char.ToUpperInvariant(fullName[0]).ToString();
    }
