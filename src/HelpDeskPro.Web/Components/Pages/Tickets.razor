    private async Task SaveFiltersToStorageAsync()
    {
        try
        {
            var state = new TicketFilterState
            {
                Statuses = _selectedStatuses.ToList(),
                Priorities = _selectedPriorities.ToList(),
                CategoryId = _selectedCategoryId,
                AssigneeId = _selectedAssigneeId,
                Unassigned = _unassignedOnly,
                Search = _search,
                PageSize = _pageSize
            };

            var storageKey = $"helpdeskpro_ticket_filter_{_currentUserId}";
            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await LocalStorage.SetItemAsync(storageKey, json);
        }
        catch
        {
            // Fail silently as required by rules
        }
    }

    private async Task RestoreFiltersFromStorageAsync()
    {
        try
        {
            var storageKey = $"helpdeskpro_ticket_filter_{_currentUserId}";
            var json = await LocalStorage.GetItemAsync(storageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var state = System.Text.Json.JsonSerializer.Deserialize<TicketFilterState>(json);
                if (state != null)
                {
                    if (state.Statuses is { Count: > 0 })
                    {
                        _selectedStatuses = new HashSet<TicketStatus>(state.Statuses);
                    }
                    if (state.Priorities is { Count: > 0 })
                    {
                        _selectedPriorities = new HashSet<TicketPriority>(state.Priorities);
                    }
                    _selectedCategoryId = state.CategoryId;
                    _selectedAssigneeId = state.AssigneeId;
                    _unassignedOnly = state.Unassigned;
                    _search = state.Search ?? string.Empty;
                    if (state.PageSize is 20 or 50 or 100)
                    {
                        _pageSize = state.PageSize;
                    }
                }
            }
        }
        catch
        {
            // Fail silently on storage error
        }
    }

    private async Task ResetFiltersAsync()
    {
        _selectedStatuses = new HashSet<TicketStatus>();
        _selectedPriorities = new HashSet<TicketPriority>();
        _selectedCategoryId = null;
        _selectedAssigneeId = null;
        _unassignedOnly = false;
        _search = string.Empty;
        _currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task OnStatusesChanged(IEnumerable<TicketStatus> values)
    {
        _selectedStatuses = values;
        _currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task OnPrioritiesChanged(IEnumerable<TicketPriority> values)
    {
        _selectedPriorities = values;
        _currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task OnCategoryChanged(int? catId)
    {
        _selectedCategoryId = catId;
        _currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task OnAssigneeChanged(Guid? assigneeId)
    {
        _selectedAssigneeId = assigneeId;
        _currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task OnUnassignedChanged(bool val)
    {
        _unassignedOnly = val;
        if (val)
        {
            _selectedAssigneeId = null;
        }
        _currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadTicketsAsync();
        }
    }

    private async Task OnSearchCleared()
    {
        _search = string.Empty;
        _currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadTicketsAsync();
    }

    private async Task HandlePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize is 20 or 50 or 100)
        {
            _pageSize = newSize;
            _currentPage = 1;
            await LoadTicketsAsync();
        }
    }

    private async Task CopyTicketNo(string ticketNo)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ticketNo);
            Snackbar.Add("Disalin", Severity.Normal, config =>
            {
                config.ShowCloseIcon = false;
                config.VisibleStateDuration = 1500;
            });
        }
        catch
        {
            // Clipboard API fallback
        }
    }

    private void NavigateToDetail(long id)
    {
        Navigation.NavigateTo($"/tickets/{id}");
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/tickets/new");
    }

    private string GetRangeText()
    {
        if (_totalCount == 0) return "0";
        var start = (_currentPage - 1) * _pageSize + 1;
        var end = Math.Min(_currentPage * _pageSize, _totalCount);
        return $"{start}–{end}";
    }

    private string GetMultiStatusText(List<string> selected)
    {
        if (selected == null || selected.Count == 0) return "Semua status";
        if (selected.Count == Enum.GetValues<TicketStatus>().Length) return "Semua status";
        return $"{selected.Count} status";
    }

    private string GetMultiPriorityText(List<string> selected)
    {
        if (selected == null || selected.Count == 0) return "Semua prioritas";
        if (selected.Count == Enum.GetValues<TicketPriority>().Length) return "Semua prioritas";
        return $"{selected.Count} prioritas";
    }

    private static string GetStatusLabel(TicketStatus status) => status switch
    {
        TicketStatus.Open => "Open",
        TicketStatus.InProgress => "In Progress",
        TicketStatus.Pending => "Pending",
        TicketStatus.Resolved => "Resolved",
        TicketStatus.Closed => "Closed",
        TicketStatus.Cancelled => "Cancelled",
        _ => status.ToString()
    };

    private static string GetPriorityLabel(TicketPriority priority) => priority switch
    {
        TicketPriority.Critical => "Critical",
        TicketPriority.High => "High",
        TicketPriority.Medium => "Medium",
        TicketPriority.Low => "Low",
        _ => priority.ToString()
    };
}
