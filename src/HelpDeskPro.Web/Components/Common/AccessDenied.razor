@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <div class="d-flex flex-column align-center gap-3" style="text-align:center;">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6">Akses ditolak</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Peran Anda tidak memiliki izin untuk membuka halaman ini.
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/"))">
            Kembali ke beranda
        </MudButton>
    </div>
</MudContainer>
