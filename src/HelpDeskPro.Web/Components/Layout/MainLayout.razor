    }

    .user-profile-btn:hover {
        background-color: #F7F7F5;
    }

    .user-info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
        text-align: left;
    }

    .user-name {
        font-size: 13px;
        font-weight: 500;
        color: #1F1F1F;
    }

    .user-role {
        font-size: 11px;
        color: #6B6B6B;
    }

    .sidebar-drawer {
        border-right: 1px solid #E4E4E0 !important;
        background-color: #FFFFFF !important;
        display: flex;
        flex-direction: column;
    }

    .drawer-brand {
        height: 50px;
        min-height: 50px;
        padding: 0 16px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid #E4E4E0;
    }

    .brand-container {
        display: flex;
        align-items: center;
    }

    .brand-text {
        font-size: 16px;
        font-weight: 700;
        color: #1F4E79;
        letter-spacing: -0.2px;
    }

    .drawer-nav-menu {
        padding: 8px 6px;
        flex: 1;
    }

    .drawer-nav-menu .mud-nav-link {
        font-size: 13px;
        padding: 6px 12px;
        border-radius: 4px;
        margin-bottom: 2px;
        color: #1F1F1F;
    }

    .drawer-nav-menu .mud-nav-link.active:not(.mud-nav-link-disabled) {
        background-color: #EBF3FA !important;
        color: #1F4E79 !important;
        font-weight: 600;
    }

    .drawer-nav-menu .mud-nav-link:hover:not(.active) {
        background-color: #F7F7F5 !important;
    }

    .drawer-footer {
        padding: 12px 16px;
        border-top: 1px solid #E4E4E0;
        text-align: center;
    }

    .version-text {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #6B6B6B;
    }

    .main-content {
        background-color: #F7F7F5;
        min-height: calc(100vh - 50px);
    }

    .content-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        padding: 24px;
    }
</style>
