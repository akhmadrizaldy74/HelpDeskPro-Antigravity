@namespace HelpDeskPro.Web.Components.Tickets
@inject IApiClient ApiClient

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-size: 16px; font-weight: 600; color: #B42318;">Eskalasi tiket @TicketNo</MudText>
    </TitleContent>
    <DialogContent>
        <div class="escalate-dialog-content">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="dialog-error-alert">
                    @_errorMessage
                </div>
            }

            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                Eskalasi manual akan menaikkan tingkat penanganan tiket ini ke atasan atau penanggung jawab tingkat lanjut.
            </MudAlert>

            <MudTextField @bind-Value="_note" 
                          Label="Catatan alasan eskalasi *" 
                          Placeholder="Jelaskan alasan mengapa tiket ini perlu dieskalasi (minimal 10 karakter)..." 
                          Lines="4" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" 
                          Counter="400" 
                          MaxLength="400" 
                          HelperText="Alasan eskalasi wajib diisi, minimal 10 karakter." />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Disabled="@_isSubmitting" Style="text-transform: none; border-radius: 4px;">
            Batal
        </MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_note) || _note.Trim().Length < 10)" Style="text-transform: none; border-radius: 4px;">
            @if (_isSubmitting)
            {
                <span class="loading-spinner-sm"></span>
                <span>Mengirim...</span>
            }
            else
            {
                <span>Eskalasi sekarang</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .escalate-dialog-content {
        min-width: 380px;
        max-width: 450px;
    }

    .dialog-error-alert {
        background-color: #FEEDE6;
        color: #B42318;
        border: 1px solid #C4320A;
        border-radius: 4px;
        padding: 8px 12px;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .loading-spinner-sm {
        width: 12px;
        height: 12px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: #FFFFFF;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 6px;
        display: inline-block;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long TicketId { get; set; }
    [Parameter] public string TicketNo { get; set; } = string.Empty;

    private string _note = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_note) || _note.Trim().Length < 10)
        {
            _errorMessage = "Catatan alasan eskalasi wajib diisi, minimal 10 karakter.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var result = await ApiClient.EscalateTicketAsync(TicketId, _note.Trim());
            if (result?.Success == true)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = result?.Errors.FirstOrDefault() ?? "Gagal melakukan eskalasi tiket.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

